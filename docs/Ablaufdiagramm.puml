@startuml
title eNoVa-Editor – Fachassistent-Ablauf (XJustiz 2900003 & 2900004)

start

partition "JavaFX-Anwendung" {
    :EnovaEditorApplication startet;
    :Bildschirmgröße ermitteln & Fenster zentrieren;
    :main-view.fxml wird geladen;
    :caseworkers.xml einlesen;
}

partition "MainController" {
    :Eingangsdaten laden (Drag & Drop / Dateidialog / CLI-Parameter);
}

if (XML-Datei ausgewählt?) then (ja)

    partition "XmlLoader & ErsuchenSachentscheidungChecker" {
        :XML-Datei einlesen (DOM Document);
        :Prüfen, ob Nachricht eNoVa 2900003 ist;
        if (Nachricht gültig?) then (ja)
        else (nein)
            :Fehlermeldung anzeigen;
            detach
        endif
    }

    partition "XPathTemplateRenderer & WebView" {
        :Input.htm einlesen & rendern;
        :HTML direkt im Anwendungsfenster anzeigen (Tab "Notaranfrage");
        :Verfahrens- & Urkundendaten für Entscheidungsmaske extrahieren;
        :Aktenzeichen-Vorschlag ableiten;
    }

    partition "Sachbearbeitung (Entscheidungserfassung)" {
        :Sachbearbeiter(in) auswählen;
        :Art der Sachentscheidung wählen (BauGB § 28, §§ 144/145, §§ 172/173);
        :Tenor, Begründung und Gebühr prüfen / anpassen;
        :Bescheid-Entwurf live in Tab 2 aktualisieren (BescheidHtmlRenderer);
    }

    partition "Export für beBPo & Veraktung" {
        :Benutzer klickt "beBPo-Paket exportieren";
        
        fork
            :EnovaResponseBuilder erzeugt\nnachricht.enova.entscheidung.2900004.xml;
            note right
                Bereit zur qualifizierten
                Signatur (qeS / CAdES detached)
                für die Rückübermittlung via beBPo
            end note
        fork again
            :BescheidPdfGenerator erzeugt\nAmtlichen Bescheid (DIN-A4 PDF);
            note right
                Druckreifes Dokument
                zur behördlichen Veraktung
                (DMS / E-Akte)
            end note
        end fork
        
        :Erfolgsmeldung anzeigen;
        :Optional: Zielordner im Windows Explorer öffnen;
    }

else (nein)
    :Warten auf Dateiauswahl oder Klick auf "Musterdaten laden";
endif

stop

@enduml