<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.ColumnConstraints?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="de.muenchen.enovaeditor.MainController">

    <top>
        <VBox spacing="15.0">

            <padding>
                <Insets
                        top="20.0"
                        right="20.0"
                        bottom="15.0"
                        left="20.0"/>
            </padding>

            <HBox spacing="15.0" alignment="CENTER_LEFT">

                <Button
                        text="XML öffnen"
                        onAction="#onXmlOpenClick"/>

                <Button
                        text="Musterdaten laden"
                        onAction="#onLoadSampleClick"/>

                <Label
                        fx:id="fileStatusLabel"
                        text="Keine Datei ausgewählt"/>

            </HBox>

            <Separator/>
        </VBox>
    </top>

    <center>
        <GridPane hgap="15.0" vgap="15.0">
            <padding>
                <Insets
                        top="20.0"
                        right="20.0"
                        bottom="15.0"
                        left="20.0"/>
            </padding>

            <columnConstraints>
                <ColumnConstraints minWidth="-Infinity"/>
                <ColumnConstraints/>
            </columnConstraints>

            <Label text="Kommunikationspartner:"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="0"/>
            <Label fx:id="senderNameLabel"
                   style="-fx-background-color: #d9d9d9; -fx-padding: 4 8 4 8;"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="0"/>

            <Label text="Aktenzeichen:"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="1"/>
            <TextField fx:id="fileNumber"
                       GridPane.fillWidth="false"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="1"/>

            <Label text="Sachbearbeiter auswählen:"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="2"/>
            <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <ComboBox
                        fx:id="caseworkerComboBox"
                        minWidth="200.0"/>
                <Label fx:id="caseworkerDetailLabel"
                       text=""
                       style="-fx-font-size: 11px; -fx-text-fill: #475569;"/>
            </VBox>

            <Label text="Entscheidung:"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="3"/>
            <ComboBox
                    fx:id="decisionComboBox"
                    minWidth="180.0"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="3"/>

            <HBox spacing="15.0" alignment="CENTER_LEFT"
                  GridPane.columnIndex="0"
                  GridPane.columnSpan="2"
                  GridPane.rowIndex="4">
                <padding>
                    <Insets top="10.0"/>
                </padding>
                <Button fx:id="previewButton"
                        text="Antwort-Vorschau anzeigen"
                        onAction="#onPreviewResponseClick"
                        disable="true"/>
                <Button fx:id="exportButton"
                        text="Sachentscheidung speichern / Export"
                        onAction="#onExportResponseClick"
                        disable="true"/>
                <Label fx:id="actionStatusLabel"
                       text=""
                       style="-fx-text-fill: #0078b4;"/>
            </HBox>
        </GridPane>
    </center>

</BorderPane>