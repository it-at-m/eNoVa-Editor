<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.muenchen.enovaeditor.MainController"
            style="-fx-background-color: #f1f5f9; -fx-font-family: 'Segoe UI', system-ui, sans-serif;">

    <!-- Kopfbereich -->
    <top>
        <VBox style="-fx-background-color: #0b2a3d; -fx-padding: 8 16 8 16;">
            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <VBox spacing="2.0">
                    <HBox alignment="BASELINE_LEFT" spacing="10.0">
                        <Label text="eNoVa-Editor"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>
                        <Label text="Version 2.0 • beBPo-Assistent"
                               style="-fx-font-size: 11px; -fx-text-fill: #38bdf8; -fx-font-weight: bold;"/>
                    </HBox>
                    <Label text="Elektronischer Notar-Verwaltungs-Austausch nach dem eNoVA-Gesetz (XJustiz 2900003 / 2900004)"
                           style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;"/>
                </VBox>

                <Pane HBox.hgrow="ALWAYS"/>

                <Button text="Musterdaten laden"
                        onAction="#onLoadSampleClick"
                        style="-fx-background-color: #1e3a5f; -fx-text-fill: #e2e8f0; -fx-font-size: 12px; -fx-cursor: hand; -fx-background-radius: 6;"/>
            </HBox>
        </VBox>
    </top>

    <!-- Hauptbereich: Geteilte Ansicht -->
    <center>
        <SplitPane dividerPositions="0.42" style="-fx-background-color: transparent;">

            <!-- Linke Spalte: Steuerung, Eingabe & Entscheidung -->
            <ScrollPane fitToWidth="true" style="-fx-background: #ffffff; -fx-background-color: #ffffff;">
                <VBox spacing="14.0" style="-fx-padding: 16;">

                    <!-- Karte 1: Eingangsdatei / beBPo-Nachricht -->
                    <VBox spacing="8.0" style="-fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 12; -fx-background-color: #ffffff; -fx-background-radius: 8;">
                        <Label text="1. EINGANGS-NACHRICHT (beBPo)"
                               style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #0078b4; -fx-letter-spacing: 1px;"/>

                        <!-- Drag & Drop Ablagezone -->
                        <VBox fx:id="dropZone"
                              alignment="CENTER"
                              spacing="6.0"
                              onMouseClicked="#onXmlOpenClick"
                              style="-fx-border-color: #93c5fd; -fx-border-style: dashed; -fx-border-width: 2; -fx-border-radius: 8; -fx-background-color: #f8fafc; -fx-padding: 12; -fx-cursor: hand;">
                            <Label text="📁 XML-Datei hierher ziehen"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #0284c7;"/>
                            <Label text="oder klicken zum Auswählen"
                                   style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                        </VBox>

                        <VBox spacing="4.0">
                            <Label fx:id="fileStatusLabel"
                                   text="Keine Datei ausgewählt"
                                   style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #0f172a;"/>
                            <Label fx:id="fileDetailLabel"
                                   text="Bitte laden Sie eine XJustiz.enova.2900003 XML-Datei"
                                   wrapText="true"
                                   style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                        </VBox>
                    </VBox>

                    <!-- Karte 2: Sachbearbeiter -->
                    <VBox spacing="8.0" style="-fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 12; -fx-background-color: #ffffff; -fx-background-radius: 8;">
                        <Label text="2. SACHBEARBEITUNG"
                               style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #0078b4; -fx-letter-spacing: 1px;"/>

                        <Label text="Zuständige(r) Sachbearbeiter(in):"
                               style="-fx-font-size: 12px; -fx-text-fill: #334155;"/>
                        <ComboBox fx:id="caseworkerComboBox"
                                  maxWidth="Infinity"
                                  style="-fx-font-size: 12px;"/>
                        <Label fx:id="caseworkerInfoLabel"
                               text=""
                               style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                    </VBox>

                    <!-- Karte 3: Sachentscheidung -->
                    <VBox spacing="10.0" style="-fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 12; -fx-background-color: #ffffff; -fx-background-radius: 8;">
                        <Label text="3. ENTSCHEIDUNG DER GEMEINDE"
                               style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #0078b4; -fx-letter-spacing: 1px;"/>

                        <VBox spacing="4.0">
                            <Label text="Art der Sachentscheidung:"
                                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
                            <ComboBox fx:id="decisionTypeComboBox"
                                      maxWidth="Infinity"
                                      style="-fx-font-size: 12px;"/>
                        </VBox>

                        <HBox spacing="10.0">
                            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                <Label text="Behörden-Aktenzeichen:"
                                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
                                <TextField fx:id="fileNumberField"
                                           promptText="z. B. 61-VKR-2026/0815"
                                           style="-fx-font-size: 12px;"/>
                            </VBox>
                            <VBox spacing="4.0" prefWidth="120.0">
                                <Label text="Gebühr / Kosten:"
                                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
                                <TextField fx:id="feeField"
                                           text="50,00 EUR"
                                           style="-fx-font-size: 12px;"/>
                            </VBox>
                        </HBox>

                        <VBox spacing="4.0">
                            <Label text="Bescheinigungstext / Entscheidungstenor:"
                                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
                            <TextArea fx:id="tenorArea"
                                      prefRowCount="3"
                                      wrapText="true"
                                      style="-fx-font-size: 12px;"/>
                        </VBox>

                        <VBox spacing="4.0">
                            <Label text="Begründung (optional):"
                                   style="-fx-font-size: 12px; -fx-text-fill: #334155;"/>
                            <TextArea fx:id="reasoningArea"
                                      prefRowCount="2"
                                      wrapText="true"
                                      style="-fx-font-size: 12px;"/>
                        </VBox>
                    </VBox>

                    <!-- Karte 4: Aktionen & Export -->
                    <VBox spacing="10.0" style="-fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-padding: 12; -fx-background-color: #f8fafc; -fx-background-radius: 8;">
                        <Label text="4. EXPORT FÜR BEBPO &amp; VERAKTUNG"
                               style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #0078b4; -fx-letter-spacing: 1px;"/>

                        <!-- Hauptaktion: beBPo-Paket -->
                        <Button fx:id="exportPackageButton"
                                text="📦 beBPo-Paket exportieren (XML &amp; PDF)"
                                maxWidth="Infinity"
                                onAction="#onExportPackageClick"
                                style="-fx-background-color: #0284c7; -fx-text-fill: #ffffff; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10 16; -fx-cursor: hand; -fx-background-radius: 6;"/>

                        <HBox spacing="8.0">
                            <Button fx:id="exportXmlButton"
                                    text="XML-Antwort (2900004)"
                                    HBox.hgrow="ALWAYS"
                                    maxWidth="Infinity"
                                    onAction="#onExportXmlClick"
                                    style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-text-fill: #0f172a; -fx-font-size: 11px; -fx-background-radius: 6; -fx-border-radius: 6; -fx-cursor: hand;"/>
                            <Button fx:id="exportPdfButton"
                                    text="Bescheid (PDF)"
                                    HBox.hgrow="ALWAYS"
                                    maxWidth="Infinity"
                                    onAction="#onExportPdfClick"
                                    style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-text-fill: #0f172a; -fx-font-size: 11px; -fx-background-radius: 6; -fx-border-radius: 6; -fx-cursor: hand;"/>
                        </HBox>

                        <Button fx:id="openBrowserButton"
                                text="Im externen Browser öffnen"
                                maxWidth="Infinity"
                                onAction="#onOpenBrowserClick"
                                style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-font-size: 11px; -fx-underline: true; -fx-cursor: hand;"/>

                        <Label fx:id="statusNotificationLabel"
                               text=""
                               wrapText="true"
                               style="-fx-font-size: 11px; -fx-text-fill: #059669; -fx-font-weight: bold;"/>
                    </VBox>

                </VBox>
            </ScrollPane>

            <!-- Rechte Spalte: Integrierte Dokumentenansicht (TabPane mit WebView) -->
            <VBox style="-fx-background-color: #ffffff;">
                <ToolBar style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
                    <Label text="Vorschau:"
                           style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #334155;"/>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Button text="🔍 Vergrößern (+)"
                            onAction="#onZoomInClick"
                            style="-fx-font-size: 11px; -fx-cursor: hand;"/>
                    <Button text="🔍 Verkleinern (-)"
                            onAction="#onZoomOutClick"
                            style="-fx-font-size: 11px; -fx-cursor: hand;"/>
                    <Separator orientation="VERTICAL"/>
                    <Button text="🖨️ Drucken"
                            onAction="#onPrintClick"
                            style="-fx-background-color: #0284c7; -fx-text-fill: #ffffff; -fx-font-size: 11px; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </ToolBar>

                <TabPane fx:id="documentTabPane"
                         tabClosingPolicy="UNAVAILABLE"
                         VBox.vgrow="ALWAYS">

                    <!-- Tab 1: Eingehende Notaranfrage -->
                    <Tab fx:id="requestTab" text="📄 Notaranfrage (Eingangsdaten)">
                        <WebView fx:id="requestWebView"/>
                    </Tab>

                    <!-- Tab 2: Bescheid-Entwurf / Negativzeugnis -->
                    <Tab fx:id="previewTab" text="📜 Bescheid-Entwurf (Negativzeugnis)">
                        <WebView fx:id="decisionPreviewWebView"/>
                    </Tab>

                    <!-- Tab 3: eNoVA- und beBPo-Praxisleitfaden -->
                    <Tab fx:id="infoTab" text="💡 Leitfaden &amp; beBPo-Hinweise">
                        <WebView fx:id="infoWebView"/>
                    </Tab>
                </TabPane>
            </VBox>

        </SplitPane>
    </center>

</BorderPane>